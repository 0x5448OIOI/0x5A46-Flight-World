            end
        end
    end
end

-- Se o painel entrou depois do job ja existir, o gancho nao pegou.
-- Ai varro a memoria (e caro, so quando precisa).
local function varrerJob()
    if not getgc or #CLASSES == 0 then return nil end
    local ok, lista = pcall(getgc, true)
    if not ok then return nil end
    local morto
    for _, o in ipairs(lista) do
        if type(o) == "table" then
            local mt = getmetatable(o)
            for _, C in ipairs(CLASSES) do
                -- pode ter job velho na memoria junto com o vivo; prefiro
                -- o que ainda tem tarefa pra fazer
                if mt == C then
                    if o.JobData and o.CurrentTask then return o end
                    morto = morto or o
                end
            end
        end
    end
    return morto
end

-- getgc(true) varre a memoria inteira: e caro demais pra chamar toda hora.
-- Com os ganchos instalados so preciso varrer quando o painel entra com um
-- job ja rodando. Entao: no maximo uma varredura a cada 10 segundos.
local ultimaVarredura = -999
-- Um job so conta como vivo se der pra saber PRA ONDE ir. Quando o job
-- termina o modulo limpa o CurrentTask mas a tabela continua na memoria;
-- se eu aceitasse ela, o auto ficaria repetindo "job without target" pra
-- sempre e nunca comecaria outro. Foi por isso que ele parava do nada.
local function jobUtil(j)
    if not j then return false end
    if j.Destroyed then return false end
    local d = j.JobData and j.JobData.Data
    local n = j.CurrentTask or (j.JobData and j.JobData.CurrentTask)
    local t = d and d.Tasks and n and d.Tasks[n]
    return (t and t.CFrame) and true or false
end

local function jobAtual()
    local j = G.__5A46_job
    if jobUtil(j) then return j end
    G.__5A46_job = nil
    if os.clock() - ultimaVarredura < 10 then return nil end
    ultimaVarredura = os.clock()
    j = varrerJob()
    if jobUtil(j) then G.__5A46_job = j return j end
    return nil
end

