local ultimaAssin, mudouEm = "", os.clock()

task.spawn(function()
    while true do
        task.wait(0.8)
        if not autoOn then mudouEm = os.clock() end
        local ok = (not (souAtual() and autoOn)) or pcall(function()
            local av = meuAviao()
            if not av then ultimoTxt = "auto · no aircraft" return end
            if not sentado() then ultimoTxt = "auto · sit in the pilot seat" return end

            -------------------------------------------------- farm puro
            if modo == "Cash farm" then
                destravar()
                pernaDeFarm(av, Vector3.new(1, 0, 0))
                pernaDeFarm(av, Vector3.new(-1, 0, 0))
                return
            end

            -------------------------------------------------- jobs
            if quebrado() then
                ultimoTxt = "auto · CRASHED, respawn the plane"
                task.wait(3)
                return
            end

            local j = jobAtual()
            if not j then
                local id = jobEscolhido and jobEscolhido.id or "2"
                local feito, por = comecarJob(id)
                ultimoTxt = feito
                    and ("auto · starting " .. (jobEscolhido and jobEscolhido.nome or id))
                    or  ("auto · " .. tostring(por))
                -- o gancho no .new avisa assim que o servidor responde (~2 s)
                local fim = os.clock() + 8
                repeat task.wait(0.4) until G.__5A46_job or os.clock() > fim or not autoOn
                if not G.__5A46_job then task.wait(2) end
                return
            end

            local cf, txt, tarefa, n = objetivo()
            if not cf then ultimoTxt = "auto · " .. tostring(txt) task.wait(1) return end

            ----------------------------------------- vigia de travamento
            -- Se nada muda (tarefa, progresso, job) por muito tempo, e
            -- porque ficou parado achando que chegou. Solta e vai de novo.
            local assin = table.concat({
                tostring(j.UUID), tostring(n), tostring(tarefa and tarefa.Progress),
            }, "/")
            -- enquanto o HUD mostra "Loading/Dropping Off" o jogo ESTA
            -- trabalhando, mesmo com o Progress parado em 0. Nao conto
            -- esse tempo como travamento, senao eu interromperia a carga.
            local ja = LP.PlayerGui:FindFirstChild("HUD")
            ja = ja and ja:FindFirstChild("JobAction")
            if assin ~= ultimaAssin or (ja and ja.Visible) then
                ultimaAssin, mudouEm = assin, os.clock()
            end
            local parado = os.clock() - mudouEm

            local dist = (av.PrimaryPart.Position - cf.Position).Magnitude
            if dist > PERTO or parado > PACIENCIA then
                if parado > PACIENCIA then
                    ultimoTxt = "auto · stuck, going again"
                    mudouEm = os.clock()
                end
                destravar()
                irAte(cf, modo == "Instant teleport")
                esperarChegar(n)
            else
                -- Esta perto — mas perto nao basta: os portoes vizinhos
                -- ficam a 40-60 studs. Se o freio nao estiver no alvo
                -- certo, encaixo no ponto exato antes de esperar.
                if (not travado) or (travado.Position - cf.Position).Magnitude > ENCAIXADO then
                    ultimoTxt = "auto · lining up on " .. tostring(txt)
                    encaixar(av, cf, 1.0)
                end
                ultimoTxt = string.format("auto · at gate (%s) %.0fs", tostring(txt), parado)
                task.wait(1)
            end
        end)
        if not ok then task.wait(2) end
    end
end)

