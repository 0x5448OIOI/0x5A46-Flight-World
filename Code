local function segurar(av, cf, seg)
    local fim = os.clock() + (seg or 1)
    while os.clock() < fim do
        if cancelar or not souAtual() then return end
        if not (av and av.Parent and av.PrimaryPart) then return end
        fixar(av, cf)
        RunService.Heartbeat:Wait()
    end
end

local function horizontal(v)
    local h = Vector3.new(v.X, 0, v.Z)
    if h.Magnitude < 0.001 then return Vector3.new(0, 0, -1) end
    return h.Unit
end

-- Trecho reto a velocidade constante, reescrevendo todo frame.
-- E ESTE movimento que o servidor conta como distancia voada.
local function trecho(av, de, para, vel, rumo)
    local dist = (para - de).Magnitude
    if dist < 0.05 then return true end
    local dur = dist / math.max(vel, 1)
    local t0 = os.clock()
    while true do
        if cancelar or not souAtual() then return false end
        if not (av and av.Parent and av.PrimaryPart) then return false end
        local a = (os.clock() - t0) / dur
        if a >= 1 then break end
        local pos = de:Lerp(para, a)
        fixar(av, CFrame.lookAt(pos, pos + rumo))
        RunService.Heartbeat:Wait()
    end
    fixar(av, CFrame.lookAt(para, para + rumo))
    return true
end

-- Encaixa o aviao no ponto EXATO do portao e prende ali. Uso quando ele
-- ja esta por perto mas nao no lugar certo (portao vizinho), e no modo
-- teleporte. Se ja estiver nivelado nao levanta — evita o pulinho feio.
local function encaixar(av, cfAlvo, segurarPor)
    local rot = cfAlvo - cfAlvo.Position
    local m = av.PrimaryPart
    if not m then return nil end
    if m.CFrame.UpVector.Y < 0.995 then
        for _ = 1, 8 do
            if cancelar or not souAtual() then return nil end
            fixar(av, CFrame.new(cfAlvo.Position + Vector3.new(0, 60, 0)) * rot)
            RunService.Heartbeat:Wait()
        end
    end
    local alt = alturaNivelada(av)
    local pouso = CFrame.new(cfAlvo.Position + Vector3.new(0, alt, 0)) * rot
    segurar(av, pouso, segurarPor or T.assentar)
    travado = pouso
    return pouso
end

-- Sobe -> atravessa -> mede a altura com o aviao ja reto -> desce ->
-- prende. Roda na propria thread; quem chama olha "viajando".
local function irAte(cfAlvo, instantaneo)
    if viajando then return false end
    local av = meuAviao()
    if not av then avisar("Aircraft", "no aircraft spawned", 3) return false end
    if not sentado() then avisar("Aircraft", "sit in the pilot seat first", 4) return false end

    viajando, cancelar = true, false
    destravar()

    task.spawn(function()
        local ok, err = pcall(function()
            local rotAlvo = cfAlvo - cfAlvo.Position

            if instantaneo then
                ultimoTxt = "teleported · pays $0"
                local pouso = encaixar(av, cfAlvo, T.assentar)
                if not T.travarNoGate then travado = nil end
                return
            end

            local partida = av:GetPivot().Position
            local mira    = cfAlvo.Position
            local rumo    = horizontal(mira - partida)
            local teto    = math.max(partida.Y, mira.Y) + T.altura
            local p1 = Vector3.new(partida.X, teto, partida.Z)
            local p2 = Vector3.new(mira.X,    teto, mira.Z)

            local total = (p1 - partida).Magnitude + (p2 - p1).Magnitude + T.altura
            ultimoTxt = string.format("flying %.0f studs", total)

            if not trecho(av, partida, p1, VELOCIDADE, rumo) then return end
            if not trecho(av, p1, p2, VELOCIDADE, rumo) then return end

            -- aqui o aviao esta reto: agora sim a altura e confiavel
            local alt = alturaNivelada(av)
            local pouso = CFrame.new(mira + Vector3.new(0, alt, 0)) * rotAlvo
            -- desce reto por cima do portao; os ultimos 20 studs bem
            -- devagar, senao o chassi marca "Crashed" e o servidor passa
            -- a recusar QUALQUER job novo (medi isso na pele)
            local freada = pouso.Position + Vector3.new(0, 20, 0)
            ultimoTxt = "descending"
            if not trecho(av, p2, freada, T.aproxima, rumo) then return end
            if not trecho(av, freada, pouso.Position, T.toque, rumo) then return end

            ultimoTxt = "landing"
            segurar(av, pouso, T.assentar)
            if T.travarNoGate then travado = pouso end
            ultimoTxt = "arrived"
        end)
        if not ok then
            ultimoTxt = "error"
            warn("[0x5A46] voo: " .. tostring(err))
        end
        viajando = false
    end)
    return true
end

-- Espera o voo acabar. Se a tarefa mudar no meio do caminho (o pickup
-- fecha enquanto voo, por exemplo), aborto e o ciclo replaneja pro
-- destino novo em vez de pousar no lugar errado.
local function esperarChegar(nEsperado)
    while viajando and autoOn and not cancelar do
        task.wait(0.3)
        local _, _, _, n2 = objetivo()
        if nEsperado and n2 and n2 ~= nEsperado then
            cancelar = true
            ultimoTxt = "auto · target changed, replanning"
            break
        end
    end
    repeat task.wait(0.1) until not viajando
end

--==================================================================
--                   FARM DE DINHEIRO (vai e vem)
--==================================================================
local function pernaDeFarm(av, dir)
    local p0 = av:GetPivot().Position
    local base = Vector3.new(p0.X, math.max(p0.Y, T.altura), p0.Z)
    local t0 = os.clock()
    while autoOn and modo == "Cash farm" and souAtual() and os.clock() - t0 < T.pernaFarm do
        if not (av.Parent and av.PrimaryPart) then return end
        local pos = base + dir * ((os.clock() - t0) * VELOCIDADE)
        fixar(av, CFrame.lookAt(pos, pos + dir))
        ultimoTxt = string.format("cash farm · %d studs/s", VELOCIDADE)
        RunService.Heartbeat:Wait()
    end
end

