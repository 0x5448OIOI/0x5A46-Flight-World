-- 0x5A46 · painel completo num arquivo so.
-- O codigo abaixo esta comprimido (LZSS + base64) porque o campo de
-- colar do executor corta em 128 KB e o painel inteiro passa disso.
-- Este cabecalho descomprime na memoria e roda. Nada e salvo em disco.
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local ORD = {}
for i = 1, 64 do ORD[B64:sub(i, i)] = i - 1 end

local function debase64(txt)
    local saida, n = {}, 0
    local acc, bits = 0, 0
    for i = 1, #txt do
        local c = txt:sub(i, i)
        local v = ORD[c]
        if v then
            acc = acc * 64 + v
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local by = math.floor(acc / (2 ^ bits))
                acc = acc - by * (2 ^ bits)
                n = n + 1
                saida[n] = string.char(by)
            end
        end
    end
    return table.concat(saida)
end

local function descomprimir(bin)
    local saida, n = {}, 0     -- pedacos ja produzidos
    local pronto = {}          -- saida como bytes, pra copiar de tras
    local m = 0
    local i, tam = 1, #bin
    local byte, char = string.byte, string.char
    while i <= tam do
        local flags = byte(bin, i)
        i = i + 1
        for bit = 0, 7 do
            if i > tam then break end
            if flags % (2 ^ (bit + 1)) >= 2 ^ bit then
                local o1, o2, c = byte(bin, i, i + 2)
                i = i + 3
                local off = o1 * 256 + o2
                local comp = c + 3
                local inicio = m - off + 1
                for k = 0, comp - 1 do
                    m = m + 1
                    pronto[m] = pronto[inicio + k]
                end
            else
                m = m + 1
                pronto[m] = byte(bin, i)
                i = i + 1
            end
        end
    end
    -- junta em blocos, senao concat de 200 mil pedacos fica pesado
    local partes, p = {}, 0
    local bloco, b = {}, 0
    for k = 1, m do
        b = b + 1
        bloco[b] = char(pronto[k])
        if b == 4096 then
            p = p + 1
            partes[p] = table.concat(bloco)
            bloco, b = {}, 0
        end
    end
    if b > 0 then
        p = p + 1
        partes[p] = table.concat(bloco, "", 1, b)
    end
    return table.concat(partes, "", 1, p)
end

