local function aeroportos()
    local out = {}
    local pasta = workspace:FindFirstChild("Airports")
    if not pasta then return out end
    for _, a in ipairs(pasta:GetChildren()) do
        local g = a:FindFirstChild("Gates")
        if g and #g:GetChildren() > 0 then out[#out + 1] = a.Name end
    end
    table.sort(out)
    return out
end

local function portoes(codigo)
    local out = {}
    local pasta = workspace:FindFirstChild("Airports")
    local a = pasta and pasta:FindFirstChild(codigo)
    local g = a and a:FindFirstChild("Gates")
    if not g then return out end
    for _, m in ipairs(g:GetChildren()) do
        local tipo = m:GetAttribute("Type")
        out[#out + 1] = m.Name .. (tipo and ("  [" .. tipo .. "]") or "")
    end
    table.sort(out)
    return out
end

local function cfDoPortao(codigo, nomeSujo)
    if not nomeSujo then return nil end
    local nome = nomeSujo:gsub("%s*%[.-%]%s*$", "")
    local pasta = workspace:FindFirstChild("Airports")
    local a = pasta and pasta:FindFirstChild(codigo)
    local g = a and a:FindFirstChild("Gates")
    local m = g and g:FindFirstChild(nome)
    local loc = m and m:FindFirstChild("Location")
    if not loc then return nil end
    return CFrame.lookAt(loc.Position, loc.Position + loc.CFrame.LookVector)
end

